{
  "name": "quorum",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "alchemy dev",
    "dev:reference": "alchemy dev --stage reference",
    "build": "turbo run build",
    "check": "vp check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "typecheck": "tsrs --noEmit -p tsconfig.json && effect-tsrs diagnostics --strict --project tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "test:golden": "pnpm --filter @quorum/simulation test:golden",
    "deploy": "alchemy deploy --stage prod",
    "i18n:extract": "node scripts/localization/extract.mjs",
    "i18n:translate": "node scripts/localization/translate.mjs",
    "i18n:compile": "node scripts/localization/compile.mjs --strict && vp fmt apps/web/src/i18n/zh-CN.ts",
    "i18n:verify": "node --test scripts/localization/protocol.test.mjs && node scripts/localization/extract.mjs && node scripts/localization/verify.mjs"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/domain": "2.0.0-beta.84",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@cloudflare/workers-types": "5.20261008.1",
    "@effect/language-service": "0.87.5",
    "@quorum/rpc": "workspace:*",
    "@types/node": "26.6.4",
    "@yielded/effect-tsrs": "0.2.3",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.0",
    "lefthook": "2.2.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.0.0"
}
